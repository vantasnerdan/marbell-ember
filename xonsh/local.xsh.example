# ~/.config/xonsh/local.xsh — your machine's environment, sourced first by rc.xsh.
# Ghostty starts xonsh directly, so nothing from ~/.bashrc is inherited: port it here.
from pathlib import Path

_home = Path.home()
for _p in reversed([
    _home / ".cargo/bin",
    _home / "anaconda3/bin",
    _home / "anaconda3/condabin",
    # Path("/usr/local/cuda/bin"),
]):
    if _p.is_dir() and str(_p) not in $PATH:
        $PATH.insert(0, str(_p))

# $EMBER_CALLSIGN = "MARBELL"   # the word in the prompt and status-line block
# $EMBER_TRANSIENT = "0"         # keep the full prompt bar on every line
# $EMBER_CPU_HOT = "0"           # cpu always in the readout (default: above 0.70)
# $EMBER_MEM_HOT = "0"           # mem always in the readout (default: above 0.80)
# $EDITOR = "nvim"
